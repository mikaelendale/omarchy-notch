#!/usr/bin/env python3
"""Switch the notch look on and off, all at once or one part at a time.

  notch-look                       show what's on
  notch-look off                   everything back to stock Omarchy
  notch-look on                    everything on
  notch-look bar on|off            the notch bar, or Omarchy's own bar
  notch-look round <px>|off        corner rounding for windows and pop-ups
                                   (14 is the notch look; off is Omarchy's square)
  notch-look surfaces on|off       frosted pop-ups, menus and notifications in
                                   your theme's colours
  notch-look claude-toasts notch|desktop
                                   Claude "needs you" alerts in the notch, or as
                                   desktop notifications from the sessions widget
  notch-look notifications notch|corner
                                   every notification centred right under the
                                   notch, or Omarchy's usual top-right corner
  notch-look windows under|below   full screen (windows run under the notch), or
                                   the notch keeps a strip and windows start below
  notch-look motion on|off         smoother window animations and soft shadows
  notch-look bell on|off           a terminal's bell marks its window as needing
                                   you, so agents other than Claude can say so
                                   (foot only)
  notch-look dock frosted|plain    the dock in the notch's style, or Omarchy's own
  notch-look font on|off           Omarchy's panels, menus, notifications and dock
                                   in the notch's font (Adwaita Sans); terminals
                                   keep the system monospace font
  notch-look preview               a minute of made-up agent sessions in the notch
                                   (and the Claude sessions panel), to see it busy
  notch-look showcase              a minute and a half of made-up sessions,
                                   notifications and privacy dots (and no network
                                   name), for screenshots that show nothing of yours
  notch-look edit                  choose what the two corners and the closed
                                   notch show, and the order of the open notch's
                                   buttons (or right-click the notch or a corner)

Every change is undone by the opposite command; nothing of Omarchy's own
is touched. The files it manages:
  ~/.config/hypr/looknfeel.lua        (blocks between "notch-look: rounding",
                                       "frost" and "motion" markers)
  ~/.config/omarchy/shell.toml        (block between "notch-look: surfaces" markers)
  ~/.config/foot/foot.ini             (block between "notch-look: bell" markers)
  ~/.config/fontconfig/conf.d/10-notch-look.conf  (the shell's font)
  ~/.config/omarchy/shell.json        (bar.id, plugins, claude-sessions notify)
  ~/.local/state/mike-notch/*.json    (preferences and the layout, the bar you had)
  ~/.config/omarchy/plugins/<you>.notifications, <you>.dock
                                      (copies of Omarchy's notifications and dock
                                       with a few lines changed; rebuilt from
                                       Omarchy's latest after every `omarchy update`)
"""

import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
LOOKNFEEL = os.path.join(HOME, ".config/hypr/looknfeel.lua")
