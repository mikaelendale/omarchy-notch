def clone_id(name):
    return f"{USERNAME}.{name}"


def clone_dir(name):
    return os.path.join(PLUGINS, clone_id(name))


FOOT = os.path.join(HOME, ".config/foot/foot.ini")
# Omarchy's shell draws everything in the system's "monospace" font; this
# fontconfig rule gives that one program (quickshell) the notch's font
# instead, so the panels, menus and notifications match the notch, while
# terminals keep their monospace font.
FONT_CONF = os.path.join(HOME, ".config/fontconfig/conf.d/10-notch-look.conf")
FONT_RULE = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- notch-look: Omarchy's shell (quickshell) draws in the notch's font,
     Adwaita Sans, instead of the system monospace font, so its panels, menus,
     notifications and dock match the notch. Terminals keep their monospace
     font. Managed by `notch-look font on|off`.

     Omarchy asks for "monospace", and later rules (Omarchy's own, and the
     fonts.conf `omarchy font set` writes) put their font first whenever that
     name is still asked for. So for this one program the name is taken out,
     and Adwaita Sans goes first; the fonts already lined up behind it stay,
     for icon glyphs, emoji and other scripts. -->
<fontconfig>
  <match target="pattern">
    <test name="prgname"><string>quickshell</string></test>
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="delete"/>
    <edit name="family" mode="prepend_first" binding="strong"><string>Adwaita Sans</string></edit>
  </match>
  <match target="pattern">
    <test name="prgname"><string>quickshell</string></test>
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="delete"/>
  </match>
  <match target="pattern">
    <test name="prgname"><string>quickshell</string></test>
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="delete"/>
  </match>
</fontconfig>
"""
FROST_START = "-- notch-look: frost"
FROST_END = "-- notch-look: end frost"
MOTION_START = "-- notch-look: motion"
MOTION_END = "-- notch-look: end motion"
BELL_START = "# notch-look: bell"
BELL_END = "# notch-look: end bell"

FROST_BLOCK = """-- notch-look: frost (managed by `notch-look surfaces on|off`)
-- Frosted glass behind the notch and its corners, the dock, notifications and
-- Omarchy's panels, using Omarchy's own glass blur (so `omarchy toggle
-- animations`, which turns blur off on slow GPUs, still wins).
require("default.hypr.glass")()
hl.layer_rule({
  match = { namespace = "^(mike-notch|omarchy-dock|omarchy-dock-apps|omarchy-notifications|omarchy-keyboard-panel|omarchy-osd|omarchy-reminders)$" },
  blur = true,
  ignore_alpha = 0.04,
})
-- Menus dim the screen behind them a little; only their card is frosted.
hl.layer_rule({
  match = { namespace = "^(omarchy-menu|omarchy-clipboard|omarchy-emojis|mike-notch-editor)$" },
  blur = true,
  ignore_alpha = 0.5,
})
-- notch-look: end frost
"""

MOTION_BLOCK = """-- notch-look: motion (managed by `notch-look motion on|off`)
-- Smooth, iOS-like window motion: quick off the mark, soft to rest, with
-- workspaces sliding and a soft shadow under each window.
hl.curve("notchOut", { type = "bezier", points = { { 0.16, 1 }, { 0.3, 1 } } })
hl.curve("notchSoft", { type = "bezier", points = { { 0.32, 0.72 }, { 0, 1 } } })
hl.curve("notchInOut", { type = "bezier", points = { { 0.65, 0 }, { 0.35, 1 } } })
hl.animation({ leaf = "windowsIn", enabled = true, speed = 4.2, bezier = "notchOut", style = "popin 90%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 2.4, bezier = "notchInOut", style = "popin 94%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = 4.6, bezier = "notchOut" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = 3.2, bezier = "notchSoft" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = 2.6, bezier = "notchSoft" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 4.4, bezier = "notchOut", style = "slide" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 4.4, bezier = "notchOut", style = "slidevert" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 3.6, bezier = "notchOut", style = "popin 94%" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 2.4, bezier = "notchInOut", style = "fade" })
hl.config({ decoration = { shadow = { enabled = true, range = 22, render_power = 3, color = "rgba(00000048)" } } })
-- notch-look: end motion
"""

BELL_BLOCK = """# notch-look: bell (managed by `notch-look bell on|off`)
# A program ringing the bell in a window you're not looking at (as coding
# agents do when they need you) is noted, and the notch shows that window's
# agent as "needs you".
[bell]
command=""" + os.path.join(PLUGIN, "bell.sh") + """
# notch-look: end bell
"""

ROUND_START = "-- notch-look: rounding"
ROUND_END = "-- notch-look: end rounding"
SURF_START = "# notch-look: surfaces"
SURF_END = "# notch-look: end surfaces"
DEFAULT_ROUND = 14


def run(*args, quiet=True):
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=20)
        return out.returncode, (out.stdout or "") + (out.stderr or "")
    except (OSError, subprocess.SubprocessError) as error:
        return 1, str(error)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".notch-look.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, path)


def read_json(path):
    try:
        return json.loads(read(path) or "{}")
    except ValueError:
        return {}


def cut_block(text, start, end):
    """(text without the marked block, the block or None)."""
    i = text.find(start)
    if i < 0:
        return text, None
    j = text.find(end, i)
    if j < 0:
        return text, None
    j = text.find("\n", j)
    j = len(text) if j < 0 else j + 1
    return text[:i].rstrip("\n") + "\n" + text[j:].lstrip("\n"), text[i:j]


# --------------------------------------------------------------- rounding

def rounding_now():
    _, block = cut_block(read(LOOKNFEEL), ROUND_START, ROUND_END)
    if not block:
        return 0
    m = re.search(r"rounding\s*=\s*(\d+)", block)
    return int(m.group(1)) if m else 0


def set_rounding(px):
    text, _ = cut_block(read(LOOKNFEEL), ROUND_START, ROUND_END)
    if px > 0:
        text = text.rstrip("\n") + "\n\n" + (
            f"{ROUND_START} (managed by `notch-look round <px>|off`)\n"
            "-- Rounded windows. Omarchy's own panels, menus, notifications, the dock and\n"
            "-- the OSD take their corner radius from this same value.\n"
            "hl.config({\n"
            "  decoration = {\n"
            f"    rounding = {px},\n"
            "    rounding_power = 2.6,\n"
            "  },\n"
            "})\n"
            f"{ROUND_END}\n"
        )
    write(LOOKNFEEL, text)
    # A reload resets every option to Omarchy's defaults before applying the
    # config, and Omarchy's shell re-reads the radius when Hyprland reloads.
    run("hyprctl", "reload")
    code, errors = run("hyprctl", "configerrors")
    if errors.strip():
        print("Hyprland config errors:\n" + errors.strip(), file=sys.stderr)


# --------------------------------------------------------------- surfaces

def surfaces_now():
    _, block = cut_block(read(SHELL_TOML), SURF_START, SURF_END)
    return block is not None


def frost_now():
    _, block = cut_block(read(LOOKNFEEL), FROST_START, FROST_END)
    return block is not None


def set_block(path, start, end, block, on):
    text, _ = cut_block(read(path), start, end)
    if on:
        text = text.rstrip("\n") + "\n\n" + block
    write(path, text)


def reload_hypr():
    run("hyprctl", "reload")
    code, errors = run("hyprctl", "configerrors")
    if errors.strip():
        print("Hyprland config errors:\n" + errors.strip(), file=sys.stderr)


def set_surfaces(on):
    # The blur behind the frosted surfaces lives in Hyprland's config.
    set_block(LOOKNFEEL, FROST_START, FROST_END, FROST_BLOCK, on)
    reload_hypr()
    text, _ = cut_block(read(SHELL_TOML), SURF_START, SURF_END)
    if on:
        body = read(SURFACES).rstrip("\n")
        if not body:
            sys.exit(f"Missing {SURFACES}; can't turn the surfaces back on.")
        text = text.rstrip("\n") + "\n\n" + (
            f"{SURF_START} (managed by `notch-look surfaces on|off`)\n"
            "# Frosted pop-ups, menus and notifications in the theme's own colours, to\n"
            "# match the notch. Keys here win over the current theme.\n"
            f"{body}\n{SURF_END}\n"
        )
    write(SHELL_TOML, text.lstrip("\n"))


# --------------------------------------------------------------- bar

def bar_now():
    bar = read_json(SHELL_JSON).get("bar", {})
    return isinstance(bar, dict) and bar.get("id") == "mike.notch"


def set_bar(on):
    if on:
        bar = read_json(SHELL_JSON).get("bar", {})
        current = bar.get("id") if isinstance(bar, dict) else None
        if current != "mike.notch":
            write(PREVIOUS, json.dumps({"bar": current or ""}) + "\n")
        target = "mike.notch"
    else:
        # Whichever bar was in use before, or Omarchy's own.
        target = read_json(PREVIOUS).get("bar") or "default"
    code, out = run("omarchy", "bar", "use", target)
    if code != 0 and not on and target != "default":
        code, out = run("omarchy", "bar", "use", "default")
    if code != 0:
        sys.exit(out.strip() or "omarchy bar use failed")


# --------------------------------------------------------------- Claude toasts

def toasts_now():
    return read_json(PREFS).get("claudeToasts") is not False


def set_toasts(in_notch):
    prefs = read_json(PREFS)
    prefs["claudeToasts"] = bool(in_notch)
    write(PREFS, json.dumps(prefs) + "\n")
    # One alert, not two: the sessions widget's own notifications are the
    # other way round.
    run("omarchy", "bar", "set", "mike.claude-sessions", "notify", "Off" if in_notch else "Unfocused")


# --------------------------------------------------------------- motion, bell, windows

def motion_now():
    _, block = cut_block(read(LOOKNFEEL), MOTION_START, MOTION_END)
    return block is not None


def set_motion(on):
    set_block(LOOKNFEEL, MOTION_START, MOTION_END, MOTION_BLOCK, on)
    reload_hypr()


def bell_now():
    _, block = cut_block(read(FOOT), BELL_START, BELL_END)
    return block is not None


def set_bell(on):
    if on and not os.path.exists(FOOT) and not shutil.which("foot"):
        print("  (the bell needs the foot terminal, which isn't installed; skipped)")
        return
    set_block(FOOT, BELL_START, BELL_END, BELL_BLOCK, on)


def font_now():
    return os.path.exists(FONT_CONF)


def set_font(on, restart=True):
    if on:
        write(FONT_CONF, FONT_RULE)
    elif os.path.exists(FONT_CONF):
        os.remove(FONT_CONF)
    if restart:
        # The shell picks its fonts when it starts.
        run("omarchy", "restart", "shell")


def windows_now():
    return read_json(PREFS).get("windowsUnderNotch") is True


def set_windows(under):
    prefs = read_json(PREFS)
    prefs["windowsUnderNotch"] = bool(under)
    write(PREFS, json.dumps(prefs) + "\n")


# --------------------------------------------------------------- notifications, dock

def plugin_enabled(plugin_id):
    code, out = run("omarchy", "plugin", "list", "--json")
    try:
        for p in json.loads(out):
            if p.get("id") == plugin_id:
                return bool(p.get("enabled"))
    except ValueError:
        pass
    return False


# Marks a copy as notch-look's own. A copy you made yourself (with
# `omarchy plugin clone`) has no mark, and notch-look never touches it.
MARK = ".notch-look"


def ours(name):
    return os.path.exists(os.path.join(clone_dir(name), MARK))


def clone_now(name):
    return ours(name) and plugin_enabled(clone_id(name))


def patch_clone(name):
    """Copy Omarchy's current version into the clone and apply the change.
    False if Omarchy's code moved on so the change no longer fits."""
    spec = CLONES[name]
    target = clone_dir(name)
    for entry in os.listdir(spec["dir"]):
        if entry == "manifest.json":
            continue  # the clone's own id and name
        src = os.path.join(spec["dir"], entry)
        dst = os.path.join(target, entry)
        if os.path.isdir(src):
            shutil.rmtree(dst, ignore_errors=True)
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)
    changed = {}
    for name, patches in spec["files"].items():
        path = os.path.join(target, name)
        text = read(path)
        for old, new in patches:
            if text.count(old) != 1:
                return False
            text = text.replace(old, new)
        changed[path] = text
    for path, text in changed.items():
        write(path, text)
    # Files of notch-look's own that the change uses.
    for name, source in spec.get("add", {}).items():
        shutil.copy2(source, os.path.join(target, name))
    return True


def install_hook():
    hook = (
        "#!/bin/bash\n"
        "# Rebuilds notch-look's copies of Omarchy's notifications and dock from the\n"
        "# version this update installed, so they keep Omarchy's fixes.\n"
        "command -v notch-look >/dev/null && notch-look refresh || true\n"
    )
    write(HOOK, hook)
    os.chmod(HOOK, 0o755)


def set_clone(name, on, restart=True):
    if os.path.isdir(clone_dir(name)) and not ours(name):
        if on:
            print(f"  ({clone_dir(name)} is your own copy of Omarchy's {name}; left as it is)")
        return
    if on:
        if not os.path.isdir(clone_dir(name)):
            code, out = run("omarchy", "plugin", "clone", CLONES[name]["source"])
            if code != 0:
                sys.exit(out.strip() or f"Couldn't copy Omarchy's {name}.")
            write(os.path.join(clone_dir(name), MARK), "Made and kept up to date by notch-look.\n")
        if not patch_clone(name):
            run("omarchy", "plugin", "disable", clone_id(name))
            sys.exit(f"Omarchy's {name} changed, so notch-look's change no longer fits; "
                     "kept Omarchy's own.")
        run("omarchy", "plugin", "enable", clone_id(name))
        install_hook()
    else:
        if os.path.isdir(clone_dir(name)):
            run("omarchy", "plugin", "disable", clone_id(name))
        if not any(clone_now(n) for n in CLONES if n != name) and os.path.exists(HOOK):
            os.remove(HOOK)
    if restart:
        # Omarchy's live reload can keep running the old code; a restart doesn't.
        run("omarchy", "restart", "shell")


def notifications_now():
    return clone_now("notifications")


def set_notifications(under_notch, restart=True):
    set_clone("notifications", under_notch, restart)


def refresh_clones():
    """After an Omarchy update: rebuild the copies from the new version."""
    changed = False
    for name in CLONES:
        if not clone_now(name):
            continue
        changed = True
        if not patch_clone(name):
            run("omarchy", "plugin", "disable", clone_id(name))
            run("omarchy-notification-send", f"notch-look: Omarchy's own {name} are back",
                f"Omarchy's update changed its {name}, so notch-look's change no longer fits.")
    if changed:
        run("omarchy", "restart", "shell")


# --------------------------------------------------------------- commands

def status():
    r = rounding_now()
    bar = bar_now()
    later = "" if bar else "  (with the notch bar)"
    current = read_json(SHELL_JSON).get("bar", {})
    current = current.get("id") if isinstance(current, dict) else None
    rows = [
        ("bar", "notch" if bar else (current or "Omarchy's own")),
        ("round", f"{r}px" if r else "off (square)"),
        ("surfaces", "frosted" if surfaces_now() else "theme's own"),
        ("claude-toasts", "in the notch" if toasts_now() else "desktop notifications"),
        ("notifications", "under the notch" if notifications_now() else "top-right corner"),
        ("windows", ("full screen, under the notch" if windows_now() else "below the notch's strip") + later),
        ("motion", "smooth" if motion_now() else "Omarchy's own"),
        ("bell", "flags the window" if bell_now() else "off"),
        ("dock", "frosted" if clone_now("dock") else "Omarchy's own"),
        ("font", "the notch's (Adwaita Sans)" if font_now() else "system monospace"),
    ]
    for name, value in rows:
        print(f"  {name:<14} {value}")


def on_off(value):
    if value in ("on", "yes", "true", "1"):
        return True
    if value in ("off", "no", "false", "0"):
        return False
    sys.exit(f"Expected on or off, got {value!r}")


def main(argv):
    if not argv:
        status()
        return 0
    cmd = argv[0]
    arg = argv[1] if len(argv) > 1 else ""
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd == "off":
        set_notifications(False, restart=False)
        set_clone("dock", False, restart=False)
        set_bar(False)
        set_rounding(0)
        set_surfaces(False)
        set_motion(False)
        set_bell(False)
        set_toasts(False)
        set_font(False, restart=False)
        run("omarchy", "restart", "shell")
        print("Back to stock Omarchy. `notch-look on` brings it all back.")
    elif cmd == "on":
        set_rounding(DEFAULT_ROUND)
        set_surfaces(True)
        set_motion(True)
        set_bell(True)
        set_toasts(True)
        set_font(True, restart=False)
        set_bar(True)
        set_clone("dock", True, restart=False)
        set_notifications(True)
        print("Notch look on.")
    elif cmd == "bar":
        set_bar(on_off(arg))
    elif cmd == "round":
        if arg in ("off", "0", "none"):
            set_rounding(0)
        elif arg.isdigit():
            set_rounding(min(40, int(arg)))
        else:
            sys.exit("Usage: notch-look round <px>|off   (14 is the notch look)")
    elif cmd == "surfaces":
        set_surfaces(on_off(arg))
    elif cmd == "windows":
        if arg not in ("under", "below"):
            sys.exit("Usage: notch-look windows under|below")
        set_windows(arg == "under")
    elif cmd == "motion":
        set_motion(on_off(arg))
    elif cmd == "bell":
        set_bell(on_off(arg))
    elif cmd == "font":
        set_font(on_off(arg))
    elif cmd == "refresh":
        refresh_clones()
        return 0
    elif cmd == "preview":
        code, _ = run("omarchy-shell", "mike.notch", "previewSessions")
        if code != 0:
            sys.exit("The notch isn't running; `notch-look bar on` first.")
        run("omarchy-shell", "mike.claude-sessions", "preview", "14")
        print("For a minute, the notch shows 14 made-up agent sessions: hover it to\n"
              "see the agents card, and click its Claude button for the sessions panel.")
        return 0
    elif cmd == "showcase":
        code, _ = run("omarchy-shell", "mike.notch", "showcase")
        if code != 0:
            sys.exit("The notch isn't running; `notch-look bar on` first.")
        print("For a minute and a half the notch shows made-up sessions, notifications\n"
              "and privacy dots, and no network name: take your screenshots.")
        return 0
    elif cmd == "edit":
        code, _ = run("omarchy-shell", "mike.notch", "edit")
        if code != 0:
            sys.exit("The notch isn't running; `notch-look bar on` first.")
        return 0
    elif cmd == "dock":
        if arg not in ("frosted", "plain"):
            sys.exit("Usage: notch-look dock frosted|plain")
        set_clone("dock", arg == "frosted")
    elif cmd == "notifications":
        if arg == "refresh":
            refresh_clones()
            return 0
        if arg not in ("notch", "corner"):
            sys.exit("Usage: notch-look notifications notch|corner")
        set_notifications(arg == "notch")
    elif cmd in ("claude-toasts", "toasts"):
        if arg not in ("notch", "desktop"):
            sys.exit("Usage: notch-look claude-toasts notch|desktop")
        set_toasts(arg == "notch")
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    status()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
