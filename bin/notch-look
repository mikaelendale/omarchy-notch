SHELL_JSON = os.path.join(HOME, ".config/omarchy/shell.json")
# This plugin's folder, wherever it was installed (notch-look lives in its bin/,
# and is linked into ~/.local/bin).
PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SURFACES = os.path.join(PLUGIN, "look/surfaces.toml")
STATE = os.path.join(HOME, ".local/state/mike-notch")
PREFS = os.path.join(STATE, "prefs.json")
# The bar in use before `notch-look on`, put back by `notch-look off`.
PREVIOUS = os.path.join(STATE, "previous.json")

PLUGINS = os.path.join(HOME, ".config/omarchy/plugins")
USERNAME = os.environ.get("USER") or os.path.basename(HOME)
HOOK = os.path.join(HOME, ".config/omarchy/hooks/post-update.d/notch-notifications")

